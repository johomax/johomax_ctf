+proc observePhase(seat: ShellSeat; wanted: StrategyPhase): bool =
+  if wanted == seat.activePhase:
+    seat.candidatePhase = wanted
+    seat.candidateViewCount = 0
+    return false
+  if seat.candidateViewCount == 0 or seat.candidatePhase != wanted:
+    seat.candidatePhase = wanted
+    seat.candidateViewCount = 1
+    return false
