+proc zoneEdgeDistance(view: StrategyView): int =
+  if not view.zone.present:
+    return -1
+  let
+    pos = view.self.pos
+    rect = view.zone.current
+    right = rect.x + rect.w
+    bottom = rect.y + rect.h
+  min(min(pos.x - rect.x, right - pos.x),
+    min(pos.y - rect.y, bottom - pos.y))
+
+proc zoneUrgent(seat: ShellSeat; view: StrategyView): bool =
+  if not view.zone.present:
+    return false
+  let edgeDistance = view.zoneEdgeDistance
+  view.zone.ticksToShrink <= ZoneUrgencyTicks or
+    edgeDistance < seat.edgeMargin
+
+proc geometryLogLine(view: StrategyView; phase: StrategyPhase): string =
+  let
+    partnerDistance =
+      if view.partner.positionKnown: int(view.partner.distance + 0.5)
+      else: -1
+    partnerFresh =
+      if view.partner.positionKnown and view.partner.fresh: 1 else: 0
+    zoneNext =
+      if view.zone.present and view.zone.nextPresent: 1 else: 0
+    ticksToShrink =
+      if view.zone.present: view.zone.ticksToShrink else: -1
+  s2LogLine("geo tick=" & $view.tick & " hp=" & $view.self.hp &
+    " partner_d=" & $partnerDistance & " partner_fresh=" & $partnerFresh &
+    " zone_edge=" & $view.zoneEdgeDistance &
+    " alive_teams=" & $view.aliveTeams & " zone_next=" & $zoneNext &
+    " ticks_to_shrink=" & $ticksToShrink & " phase=" & phase.phaseName)
+
+proc logGeometry(seat: ShellSeat; view: StrategyView; phase: StrategyPhase) =
+  let phaseChanged = not seat.geometryPhaseSeen or
+    seat.geometryPhase != phase
+  if phaseChanged or int(view.tick) - seat.lastGeometryTick >=
+      GeometryLogIntervalTicks:
+    echo view.geometryLogLine(phase)
+    flushFile(stdout)
+    seat.lastGeometryTick = int(view.tick)
+  seat.geometryPhase = phase
+  seat.geometryPhaseSeen = true
+
+proc partnerBlocksFightLine(view: StrategyView): bool =
+  let
+    mx = float(view.partner.pos.x - view.self.pos.x)
+    my = float(view.partner.pos.y - view.self.pos.y)
+  for enemy in view.visibleEnemies:
+    let
+      dx = float(enemy.pos.x - view.self.pos.x)
+      dy = float(enemy.pos.y - view.self.pos.y)
+      rangeSquared = dx * dx + dy * dy
+      alongNumerator = mx * dx + my * dy
+    if rangeSquared <= 0.0 or alongNumerator <= 0.0 or
+        alongNumerator >= rangeSquared:
+      continue
+    let cross = mx * dy - my * dx
+    if cross * cross <= PartnerLineHalfWidth * PartnerLineHalfWidth *
+        rangeSquared:
+      return true
+  false
