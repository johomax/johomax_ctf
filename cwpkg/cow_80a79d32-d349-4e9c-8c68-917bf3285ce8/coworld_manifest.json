            "type": "boolean"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One win flag per player slot."
        },
        "team": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One team name (red or blue) per player slot."
        },
        "kills": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One kill count per player slot."
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One player name or address per player slot."
        },
        "deaths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One death count per player slot."
