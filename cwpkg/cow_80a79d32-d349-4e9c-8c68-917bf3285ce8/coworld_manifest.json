        },
        "captures": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One heart-capture count per player slot."
        }
      },
      "additionalProperties": false
    },
