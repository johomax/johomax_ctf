+    hi = defs.len - 1
+  while lo <= hi:
+    let mid = (lo + hi) shr 1
+    if defs[mid].spriteId == spriteId:
+      return mid
+    elif defs[mid].spriteId < spriteId:
+      lo = mid + 1
+    else:
+      hi = mid - 1
