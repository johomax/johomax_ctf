__pycache__/
*.pyc

# Generated Experience Request bodies (scripts/run_experiment.py) and local
# episode output. Both are records of a particular run, not source.
arms/
episodes/

# Session-specific CA bundle for the sandbox Docker build. Regenerate with
# `cp /root/.ccr/ca-bundle.crt bot/ccr-agent-proxy.crt` -- the proxy CA changes
# every session, so a committed copy is stale the moment it lands.
bot/ccr-agent-proxy.crt

# Downloaded coworld package (`coworld download ctf -o cwpkg`). Upstream
# artifact, re-fetchable, and version-pinned to whatever was current that day.
cwpkg/

# Written by `nimby sync` with absolute --path lines into ~/.nimby/pkgs, so it
# is machine-specific by construction. The Docker build runs its own sync and
# generates its own; a committed copy would be copied OVER that one.
bot/nim.cfg

# The engine checkout the local simulator builds against (sim/bootstrap.sh).
# Upstream source at the commit sim/engine.pin names, so it is re-fetchable and
# pinned; vendoring it here would be a second copy to keep in sync.
.engine

# Scratch build tree for the simulator: two copies of a policy tree, a host
# each, a generated nim.cfg with absolute dependency paths, and a nimcache.
# Every file in it is regenerated by sim/build.sh on the next run. The
# -decoder variant is the same thing for sim/test_decoder.sh.
.sim-build/
.sim-build-decoder/

# Dependency checkouts for the two locks (scripts/sync_deps.sh): the engine's
# for the simulator, the bot's for the amd64 ship build. Upstream repos at
# pinned SHAs, so re-fetchable, and machine-specific absolute paths land in
# their generated nim.cfg / paths.cfg.
.nimby-deps/
.bot-deps/

# The metta1 access key, handed over in the session that started using that
# box for measurement. A private key belongs in no repository.
in_office_mettabox

# agent worktrees (isolated copies of this repo; never part of it)
.claude/worktrees/
