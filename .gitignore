__pycache__/
*.pyc

# Generated Experience Request bodies (scripts/run_experiment.py) and local
# episode output. Both are records of a particular run, not source.
arms/
episodes/

# Session-specific CA bundle for the sandbox Docker build. Regenerate with
# `cp /root/.ccr/ca-bundle.crt bot/ccr-agent-proxy.crt` -- the proxy CA changes
# every session, so a committed copy is stale the moment it lands.
bot/ccr-agent-proxy.crt

# Downloaded coworld package (`coworld download ctf -o cwpkg`). Upstream
# artifact, re-fetchable, and version-pinned to whatever was current that day.
cwpkg/

# Written by `nimby sync` with absolute --path lines into ~/.nimby/pkgs, so it
# is machine-specific by construction. The Docker build runs its own sync and
# generates its own; a committed copy would be copied OVER that one.
bot/nim.cfg
